# ── Arbiter Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it contains secrets.

# MLflow (experiment tracking + model registry)
MLFLOW_TRACKING_URI=http://localhost:5000

# Supabase (audit log store)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# Groq (LLM for governance agent reasoning)
GROQ_API_KEY=gsk_your-groq-api-key-here

# Redis (Feast online feature store)
REDIS_HOST=localhost
REDIS_PORT=6379

# Feast
FEAST_REPO_PATH=src/features

# Serving
API_HOST=0.0.0.0
API_PORT=8000
PRODUCTION_MODEL_URI=models:/credit_champion/Production

# Prefect
PREFECT_API_URL=http://localhost:4200/api
